FFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1300" y="290" width="24" height="24" as="geometry"/></mxCell><mxCell id="c49" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E88E5;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="590" width="24" height="24" as="geometry"/></mxCell><mxCell id="c50" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E88E5;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1300" y="626" width="24" height="24" as="geometry"/></mxCell><mxCell id="c51" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E88E5;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="390" width="24" height="24" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Luồng hoạt động&lt;/b&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; SV truy cập Grafana (:2404) và SSH (:22) qua Internet Gateway; Alertmanager chỉ xem qua SSH tunnel.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Grafana truy vấn Prometheus bằng PromQL, hiển thị dashboard Node Exporter Full.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Prometheus scrape node_exporter :9100 qua private IP (basic auth); sg-target chỉ nhận 9100 từ sg-monitor.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Prometheus gọi EC2 DescribeInstances (ec2_sd_configs, tag Monitoring=node) bằng LabInstanceProfile.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Rule vi phạm → Alertmanager → Slack #alerts.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; CloudWatch Agent đẩy CPU / RAM / Disk lên CloudWatch Metrics + Dashboard.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; CloudWatch Alarm → SNS → Email (đối chiếu với luồng 5).&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Grafana đọc datasource CloudWatch để so sánh trên cùng giao diện." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;spacing=10;strokeColor=#D5DBDB;fillColor=#FAFAFA;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="160" y="840" width="1180" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>